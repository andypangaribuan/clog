#: initialize the directory
function init {
  sudo rm -rf vol
  mkdir -p vol
  sudo chmod a+rwx vol
}


#: restart the container
function restart {
  if compose ps -q | grep -q .; then
    compose down
  fi
  
  compose up -d
}


#: show information
function show {
  local options=(
    "logs     live logs"
    "list     container list"
    "health   check health"
    "status   check jetstream engine status"
    "message  check the ack and pending message"
  )

  local selected
  selected=$(printf "%s\n" "${options[@]}" | gum choose --header "mode" | awk '{print $1}')
  [[ -z "$selected" ]] && exit 0
  
  case $selected in
    "logs")   compose logs -tf ;;
    "list")   compose ps -a ;;
    "health") curl http://localhost:4002/healthz ;;
    "status") curl http://localhost:4002/jsz ;;
    "message")
        docker run --rm \
        --network xnet \
        natsio/nats-box \
        nats --server nats://clog-nats-jetstream:4222 \
        consumer list CLOG_STREAM

        docker run --rm \
        --network xnet \
        natsio/nats-box \
        nats --server nats://clog-nats-jetstream:4222 \
        consumer info CLOG_STREAM clickhouse_inserter
      ;;
  esac
}



#: space
[ -z "$TASKFILE_EXECUTOR" ] && sq taskfile --execute "$@"
