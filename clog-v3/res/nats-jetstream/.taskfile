#: initialize the directory
function init {
  sudo rm -rf vol
  mkdir -p vol
  sudo chmod a+rwx vol
}

#: restart the container
function restart {
  if compose ps -q | grep -q .; then
    compose down
  fi
  
  compose up -d
}


#: check health
function health {
  curl http://localhost:4002/healthz
}


#: check jetstream engine status
function js {
  curl http://localhost:4002/jsz
}



#: space
[ -z "$TASKFILE_EXECUTOR" ] && sq taskfile --execute "$@"
